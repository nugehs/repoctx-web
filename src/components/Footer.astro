---
const repo = "https://github.com/BASHBOP/otito";
const cols = [
  {
    title: "product",
    links: [
      { label: "trust-layer", href: "#trust" },
      { label: "features", href: "#features" },
      { label: "mcp-server", href: "#mcp" },
      { label: "install", href: "#install" },
    ],
  },
  {
    title: "resources",
    links: [
      { label: "docs", href: repo + "/tree/main/docs" },
      { label: "github", href: repo },
      { label: "changelog", href: repo + "/blob/main/CHANGELOG.md" },
    ],
  },
  {
    title: "project",
    links: [
      { label: "issues", href: repo + "/issues" },
      { label: "release notes", href: repo + "/releases" },
      { label: "security", href: repo + "/blob/main/SECURITY.md" },
      { label: "license", href: repo + "/blob/main/LICENSE" },
    ],
  },
];
---

<footer class="border-t border-line bg-term-2">
  <div class="seam h-px w-full opacity-50"></div>
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <a href="#top" class="flex items-center gap-2.5">
          <img
            src={import.meta.env.BASE_URL + "/logo.svg"}
            alt=""
            width="26"
            height="26"
          />
          <span class="text-sm font-bold tracking-tight text-fg-bright">
            <span class="text-dim">~/</span>otito
          </span>
        </a>
        <p class="mt-4 max-w-xs text-[0.8rem] leading-relaxed text-dim">
          <span class="text-faint"># </span>local-first repository context.
          context, tests, permissions, review, evidence.
        </p>
      </div>

      {
        cols.map((col) => (
          <div>
            <h4 class="text-[0.7rem] tracking-widest text-faint">
              {col.title}/
            </h4>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.8rem] text-dim transition-colors hover:text-blue"
                  >
                    <span class="text-faint">▸</span> {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 border-t border-line pt-6 text-[0.75rem] text-faint">
      <p class="leading-relaxed">
        Òtítọ́ is a Bashbop Ltd product for deterministic repository evidence.
        Context, tests, permissions, review, and durable evidence — never model guesswork.
      </p>
      <div
        class="mt-4 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center"
      >
        <p>© 2026 Bashbop Ltd · MIT licensed</p>
        <p>
          <span class="text-green">$</span> npm publication pending
          <span class="cursor ml-1 !h-3 !w-2 align-middle"></span>
        </p>
      </div>
    </div>
  </div>
</footer>
